<% content_for :title, @price_item.name %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-800"><%= @price_item.name %></h1>
  <div class="flex gap-2">
    <%= link_to "Modifier", edit_price_item_path(@price_item), class: "bg-white border border-slate-300 text-slate-700 px-4 py-2 rounded hover:bg-slate-50" %>
    <%= link_to "Retour à la liste", price_items_path, class: "px-4 py-2 text-slate-600 hover:underline" %>
  </div>
</div>

<div class="bg-white border border-slate-200 rounded shadow-sm p-6 max-w-xl mb-8">
  <dl class="grid grid-cols-2 gap-y-3 text-sm">
    <dt class="text-slate-500">Date du document</dt>
    <dd class="text-slate-800"><%= @price_item.last_invoice_date&.strftime("%d.%m.%Y") || "—" %></dd>

    <dt class="text-slate-500">N° de l'offre ou de la facture</dt>
    <dd class="text-slate-800 font-mono"><%= @price_item.last_invoice_number.presence || "—" %></dd>

    <dt class="text-slate-500">Nom du fournisseur</dt>
    <dd class="text-slate-800"><%= @price_item.category.presence || "—" %></dd>

    <dt class="text-slate-500">Fournisseur factureur</dt>
    <dd class="text-slate-800"><%= @price_item.invoicing_supplier_name.presence || "—" %></dd>

    <dt class="text-slate-500">Numero d'article</dt>
    <dd class="text-slate-800">
      <% if @price_item.article_number.present? %>
        <span class="font-mono bg-amber-100 text-amber-900 px-2 py-0.5 rounded font-semibold"><%= @price_item.article_number %></span>
      <% else %>
        —
      <% end %>
    </dd>

    <dt class="text-slate-500">Désignation de l'article</dt>
    <dd class="text-slate-800"><%= @price_item.name %></dd>

    <dt class="text-slate-500">Prix unitaire inclus rabais</dt>
    <dd class="text-slate-800 font-mono"><%= number_to_currency(@price_item.reference_price, unit: "#{@price_item.currency} ", format: "%u %n") %></dd>

    <dt class="text-slate-500">Unité monétaire</dt>
    <dd class="text-slate-800"><%= @price_item.currency %></dd>

    <dt class="text-slate-500">Quantité unitaire</dt>
    <dd class="text-slate-800"><%= @price_item.last_order_quantity.presence || "—" %></dd>

    <dt class="text-slate-500">Unité de la quantité</dt>
    <dd class="text-slate-800"><%= @price_item.unit.presence || "—" %></dd>

    <dt class="text-slate-500">Montant total article</dt>
    <dd class="text-slate-800 font-mono"><%= @price_item.last_total.present? ? number_to_currency(@price_item.last_total, unit: "#{@price_item.currency} ", format: "%u %n") : "—" %></dd>

    <dt class="text-slate-500">Adresse de livraison</dt>
    <dd class="text-slate-800"><%= @price_item.delivery_address.presence || "—" %></dd>

    <dt class="text-slate-500">Type de livraison</dt>
    <dd class="text-slate-800"><%= @price_item.delivery_type.presence || "—" %></dd>

    <dt class="text-slate-500">Notes</dt>
    <dd class="text-slate-800"><%= simple_format(@price_item.notes.presence || "—") %></dd>
  </dl>
</div>

<% if @chart_points.size >= 2 %>
  <h2 class="text-lg font-semibold text-slate-800 mb-3">Évolution dans le temps</h2>
  <div class="grid md:grid-cols-2 gap-4 mb-8 max-w-4xl">
    <div class="bg-white border border-slate-200 rounded shadow-sm p-4">
      <div class="text-xs uppercase text-slate-500 mb-2">Prix facturé (CHF)</div>
      <canvas id="price-chart" height="180"></canvas>
    </div>
    <div class="bg-white border border-slate-200 rounded shadow-sm p-4">
      <div class="text-xs uppercase text-slate-500 mb-2">Quantité facturée</div>
      <canvas id="quantity-chart" height="180"></canvas>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <script>
    (function () {
      var points = <%= raw @chart_points.to_json %>;
      var labels = points.map(function (p) { return p.date; });

      new Chart(document.getElementById("price-chart"), {
        type: "line",
        data: {
          labels: labels,
          datasets: [{
            label: "Prix (CHF)",
            data: points.map(function (p) { return p.price; }),
            borderColor: "#1e293b",
            backgroundColor: "rgba(30,41,59,0.08)",
            tension: 0.15,
            fill: true,
            pointRadius: 3
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });

      new Chart(document.getElementById("quantity-chart"), {
        type: "bar",
        data: {
          labels: labels,
          datasets: [{
            label: "Quantité",
            data: points.map(function (p) { return p.quantity; }),
            backgroundColor: "#94a3b8"
          }]
        },
        options: {
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    })();
  </script>
<% end %>

<h2 class="text-lg font-semibold text-slate-800 mb-3">Historique des prix</h2>
<div class="bg-white border border-slate-200 rounded shadow-sm overflow-hidden max-w-xl">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-100 text-slate-600 uppercase text-xs">
      <tr>
        <th class="px-4 py-2">Prix</th>
        <th class="px-4 py-2">Effectif jusqu'au</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @price_item.price_item_versions.each do |version| %>
        <tr>
          <td class="px-4 py-2 font-mono"><%= number_to_currency(version.reference_price, unit: "CHF ", format: "%u %n") %></td>
          <td class="px-4 py-2 text-slate-500"><%= version.changed_at.strftime("%d.%m.%Y %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2 class="text-lg font-semibold text-slate-800 mb-3 mt-8">Factures rapprochées (contrôle des ratios)</h2>
<div class="bg-white border border-slate-200 rounded shadow-sm overflow-hidden max-w-2xl">
  <table class="w-full text-left text-sm">
    <thead class="bg-slate-100 text-slate-600 uppercase text-xs">
      <tr>
        <th class="px-4 py-2">N° facture</th>
        <th class="px-4 py-2">Fournisseur</th>
        <th class="px-4 py-2">Description facture</th>
        <th class="px-4 py-2 text-right">Prix facturé</th>
        <th class="px-4 py-2 text-right">Ratio</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @invoice_lines.each do |line| %>
        <tr class="<%= 'bg-red-50' if line.anomalous? %>">
          <td class="px-4 py-2"><%= link_to line.invoice.invoice_number.presence || "—", line.invoice, class: "font-mono text-slate-700 hover:underline" %></td>
          <td class="px-4 py-2"><%= line.invoice.supplier.name %></td>
          <td class="px-4 py-2 text-slate-600"><%= line.description %></td>
          <td class="px-4 py-2 text-right font-mono"><%= number_to_currency(line.unit_price, unit: "CHF ", format: "%u %n") %></td>
          <td class="px-4 py-2 text-right font-mono font-bold <%= 'text-red-600' if line.anomalous? %>">
            <%= line.ratio ? number_to_percentage(line.ratio * 100, precision: 1) : "—" %>
          </td>
        </tr>
      <% end %>
      <% if @invoice_lines.empty? %>
        <tr><td colspan="5" class="px-4 py-6 text-center text-slate-400">Aucune facture rapprochée pour cet article.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
