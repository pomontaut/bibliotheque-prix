<%= form_with model: price_item, class: "space-y-4 max-w-xl" do |f| %>
  <% if price_item.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded px-4 py-3">
      <p class="font-semibold mb-1"><%= pluralize(price_item.errors.count, "erreur") %> :</p>
      <ul class="list-disc list-inside text-sm">
        <% price_item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nom", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-slate-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :article_number, "N° article (fournisseur)", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :article_number, class: "w-full border border-slate-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :category, "Catégorie", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :category, class: "w-full border border-slate-300 rounded px-3 py-2" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :unit, "Unité (m2, ml, pièce...)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :unit, class: "w-full border border-slate-300 rounded px-3 py-2" %>
    </div>
    <div>
      <%= f.label :last_order_quantity, "Quantité (dernier achat)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :last_order_quantity, step: 0.001, class: "w-full border border-slate-300 rounded px-3 py-2" %>
    </div>
  </div>

  <div>
    <%= f.label :reference_price, "Prix de référence (CHF)", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.number_field :reference_price, step: 0.01, min: 0, class: "w-full border border-slate-300 rounded px-3 py-2" %>
  </div>

  <div>
    <%= f.label :notes, "Notes", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_area :notes, rows: 3, class: "w-full border border-slate-300 rounded px-3 py-2" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit "Enregistrer", class: "bg-slate-800 text-white px-4 py-2 rounded hover:bg-slate-700 cursor-pointer" %>
    <%= link_to "Annuler", price_items_path, class: "px-4 py-2 text-slate-600 hover:underline" %>
  </div>
<% end %>
