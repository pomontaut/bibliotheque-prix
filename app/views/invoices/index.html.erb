<% content_for :title, "Factures" %>

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-slate-800">Factures</h1>
  <%= link_to "Importer une facture", new_invoice_path, class: "bg-slate-800 text-white px-4 py-2 rounded hover:bg-slate-700" %>
</div>

<div class="bg-white border border-slate-200 rounded shadow-sm overflow-hidden">
  <table class="w-full text-left">
    <thead class="bg-slate-100 text-slate-600 text-sm uppercase">
      <tr>
        <th class="px-4 py-3">Fournisseur</th>
        <th class="px-4 py-3">N° facture</th>
        <th class="px-4 py-3">Date</th>
        <th class="px-4 py-3">Lignes</th>
        <th class="px-4 py-3">Statut</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @invoices.each do |invoice| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3 font-medium"><%= invoice.supplier.name %></td>
          <td class="px-4 py-3 text-slate-600"><%= invoice.invoice_number %></td>
          <td class="px-4 py-3 text-slate-600"><%= invoice.invoice_date&.strftime("%d.%m.%Y") %></td>
          <td class="px-4 py-3 text-slate-600"><%= invoice.invoice_lines.count %></td>
          <td class="px-4 py-3">
            <% badge = { "pending" => "bg-amber-100 text-amber-800", "reviewed" => "bg-blue-100 text-blue-800", "integrated" => "bg-green-100 text-green-800" } %>
            <span class="text-xs font-semibold px-2 py-1 rounded <%= badge[invoice.status] %>"><%= invoice.status %></span>
          </td>
          <td class="px-4 py-3 text-right">
            <%= link_to "Contrôler", invoice, class: "text-sm text-slate-600 hover:underline mr-3" %>
            <%= link_to "Supprimer", invoice, data: { turbo_method: :delete, turbo_confirm: "Supprimer cette facture ?" }, class: "text-sm text-red-600 hover:underline" %>
          </td>
        </tr>
      <% end %>
      <% if @invoices.empty? %>
        <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">Aucune facture importée.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
